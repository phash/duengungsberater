# ── Düngungsberater Docker-Konfiguration ──
#
# Kopiere diese Datei nach .env und passe die Werte an:
#   cp .env.docker .env
#
# Starten:
#   docker compose up -d --build
#
# Stoppen:
#   docker compose down

# ── Site URL (öffentliche Adresse der App) ──
# Lokal: http://localhost
# VPS:   https://duenger.example.com
SITE_URL=http://localhost:3080
APP_PORT=3080

# ── Mail (Inbucket Web-UI zum Lesen der E-Mails) ──
MAIL_PORT=9000

# ── E-Mail-Bestätigung ──
# true = Autoconfirm (kein E-Mail nötig), false = E-Mail muss bestätigt werden
MAILER_AUTOCONFIRM=true

# ── PostgreSQL ──
# WICHTIG: Eigenes Passwort setzen! Z.B.: openssl rand -base64 24
POSTGRES_PASSWORD=REPLACE_ME_WITH_GENERATED_PASSWORD

# ── JWT (min. 32 Zeichen, für Produktion unbedingt ändern!) ──
# WICHTIG: Generiere einen eigenen Secret: openssl rand -base64 32
JWT_SECRET=REPLACE_ME_WITH_GENERATED_SECRET

# ── Supabase API Keys (generiert aus JWT_SECRET) ──
# WICHTIG: Eigene Keys generieren! Siehe: https://supabase.com/docs/guides/self-hosting/docker#api-keys
# Oder ./generate-env.sh ausführen, um .env automatisch zu erzeugen.
# NIEMALS mit den Platzhaltern öffentlich deployen!
ANON_KEY=REPLACE_ME_WITH_GENERATED_ANON_KEY
SERVICE_ROLE_KEY=REPLACE_ME_WITH_GENERATED_SERVICE_ROLE_KEY
