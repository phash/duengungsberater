# ── Düngungsberater Docker-Konfiguration ──
#
# Kopiere diese Datei nach .env und passe die Werte an:
#   cp .env.docker .env
#
# Starten:
#   docker compose up -d --build
#
# Stoppen:
#   docker compose down

# ── Site URL (öffentliche Adresse der App) ──
# Lokal: http://localhost
# VPS:   https://duenger.example.com
SITE_URL=http://localhost:3080
APP_PORT=3080

# ── Mail (Inbucket Web-UI zum Lesen der E-Mails) ──
MAIL_PORT=9000

# ── E-Mail-Bestätigung ──
# true = Autoconfirm (kein E-Mail nötig), false = E-Mail muss bestätigt werden
MAILER_AUTOCONFIRM=true

# ── PostgreSQL ──
POSTGRES_PASSWORD=your-super-secret-db-password

# ── JWT (min. 32 Zeichen, für Produktion unbedingt ändern!) ──
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# ── Supabase API Keys (generiert aus JWT_SECRET) ──
# Dies sind die offiziellen Supabase-Demo-Keys.
# Für Produktion eigene generieren: https://supabase.com/docs/guides/self-hosting/docker#api-keys
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
